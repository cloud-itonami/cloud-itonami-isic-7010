;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a document-courier robot moves physical
;; unit-reporting packages between subsidiaries (ISIC 7010, activities of head
;; offices). Its physical work: couriering sealed reporting packages across the
;; group campus (outdoor path with a ramp), and posting them into the head
;; office's secure intake locker.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-7010"
 :cases
 [{:id :reporting-package-across-campus
   :kind :transport
   :procedure "courier robot carries a subsidiary's sealed month-end reporting package across the campus path to head office"
   :params {:mass-kg 50.0 :payload-kg 8.0 :v-max-mps 1.4 :a-max-mps2 0.5
            :brake-decel-mps2 1.0 :drive-force-n 160.0 :crr 0.03 :slope-deg 3.0
            :cog-height-m 0.50 :support-half-length-m 0.28 :max-time-s 3600.0}
   :sweep {:param :distance-m :values [100.0 200.0 350.0 500.0 800.0]}
   :quantity :cycle-time-s
   :limit {:max 420.0 :basis "estimate: package reaches head office within 7 minutes of the subsidiary's sign-off"}
   :boundary {:lo 50.0 :hi 1500.0}}
  {:id :package-into-intake-locker
   :kind :manipulator
   :procedure "arm lifts the package from the robot's bay and posts it into an upper compartment of the secure intake locker"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 3.5 :m2-kg 2.5
            :from [0.40 0.05] :to [0.55 0.55] :steps 500 :payload-kg 3.0}
   :sweep {:param :duration-s :values [0.6 0.9 1.3 2.0 3.0]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a light collaborative arm (~5 kg class)"}
   :boundary {:lo 0.3 :hi 5.0}}]}
